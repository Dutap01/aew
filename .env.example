# docker-compose 용 환경변수. 복사해서 .env 로 쓰거나, 서버의 고정 경로(예: /etc/aew/aew.env)에 두고 ENV_FILE 로 지정한다.
# .env 는 git 에 올리지 않는다 (.gitignore).

# 실행할 이미지 (build_docker.sh 가 자동 지정)
APP_IMAGE=aew:latest
# 호스트에 노출할 포트
APP_PORT=8080

# DB 비밀번호 (필수, 처음 정한 값을 바꾸지 않는다: DB 볼륨이 이 비밀번호로 만들어진다)
DB_PASSWORD=change-me-strong-password

# 첫 배포 때 만들 대표 계정 (8자 이상). 대표 계정이 생긴 뒤에는 지워도 된다
OWNER_LOGIN_ID=owner
OWNER_PASSWORD=
OWNER_NAME=대표

# HTTPS(도메인) 연결 후 true
SESSION_COOKIE_SECURE=false
# 도메인 연결용 (아직 미사용)
DOMAIN=example.com
